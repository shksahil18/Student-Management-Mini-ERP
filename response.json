  "components": {
    "schemas": {
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "additionalProperties": false
      },
      "AuthResponseDtoApiResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "$ref": "#/components/schemas/AuthResponseDto"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BooleanApiResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "type": "boolean"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateFeeDto": {
        "required": [
          "dueDate",
          "studentId",
          "totalAmount"
        ],
        "type": "object",
        "properties": {
          "studentId": {
            "type": "integer",
            "format": "int32"
          },
          "totalAmount": {
            "maximum": 10000000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CreatePaymentDto": {
        "required": [
          "amount",
          "paymentMethod"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "maximum": 10000000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "paymentMethod": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "notes": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateStudentDto": {
        "required": [
          "admissionDate",
          "course",
          "dateOfBirth",
          "email",
          "firstName",
          "gender",
          "lastName",
          "phone"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "lastName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "gender": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "phone": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "format": "tel"
          },
          "address": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "admissionDate": {
            "type": "string",
            "format": "date-time"
          },
          "course": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DashboardSummaryDto": {
        "type": "object",
        "properties": {
          "totalStudents": {
            "type": "integer",
            "format": "int32"
          },
          "activeStudents": {
            "type": "integer",
            "format": "int32"
          },
          "inactiveStudents": {
            "type": "integer",
            "format": "int32"
          },
          "totalFeesBilled": {
            "type": "number",
            "format": "double"
          },
          "totalFeesCollected": {
